/*
 * ==============================================================================
 * TESTCASE 9
 * Precondition: Att_Cnt(ASK) = 2 && Att_Cnt(OEUK) = 1
 * Action:
 *   1. OEUK key NOK => NRC 36
 *   2. Timer 180s expire
 *   3. Request ASK key => NRC 35
 *   4. Request OEUK 2nd time => NRC 36
 * ==============================================================================
 */
testcase TC_09_ASK_Att2_OEUK1_OeukNOK_Wait180s_AskNOK()
{
  testCaseTitle("TC_09", "Check Att_Cnt(ASK)=2, OEUK=1: OEUK NOK => NRC 36 -> 180s -> ASK => NRC 35 -> OEUK => NRC 36");
  write("\n=================================================");
  write("[TC_09] START: ASK(2), OEUK(1) -> OEUK NOK => 36 -> 180s -> ASK => 35 -> OEUK => 36");
  write("=================================================");

  // Set precondition: Att_Cnt(ASK) = 2, Att_Cnt(OEUK) = 1
  Set_Precondition_Att_Cnt(2, 1);

  // 1. Send OEUK key NOK -> Expect NRC 36 (Triggers 180s delay)
  testStep("STEP_1", "1. Request OEUK key NOK -> Expect NRC 36");
  Send_SecurityAccess_InvalidKey(SUBFUNC_OEUK_SEED, SUBFUNC_OEUK_KEY, NRC_EXCEEDED_NUMBER_OF_ATTEMPTS);

  // 2. Wait 180s lockout timer to expire (OEUK resets to 0, ASK remains 2)
  testStep("STEP_2", "2. Waiting 180 seconds for lockout penalty to expire...");
  Wait_Lockout_Timer_180s();

  // 3. Request ASK key NOK -> Expect NRC 35
  testStep("STEP_3", "3. Request ASK key NOK -> Expect NRC 35");
  Send_SecurityAccess_InvalidKey(SUBFUNC_ASK_SEED, SUBFUNC_ASK_KEY, NRC_INVALID_KEY);

  // 4. Request OEUK key NOK 2nd time -> Expect NRC 36
  testStep("STEP_4", "4. Request OEUK key NOK 2nd time -> Expect NRC 36");
  Send_SecurityAccess_InvalidKey(SUBFUNC_OEUK_SEED, SUBFUNC_OEUK_KEY, NRC_EXCEEDED_NUMBER_OF_ATTEMPTS);

  write("[TC_09] FINISHED\n");
}

/*
 * ==============================================================================
 * TESTCASE 10
 * Precondition: Att_Cnt(ASK) = 3 && Att_Cnt(OEUK) = 2
 * Action:
 *   1. OEUK key NOK => NRC 36
 *   2. Timer 180s expire
 *   3. Request ASK => NRC 36
 * ==============================================================================
 */
testcase TC_10_ASK_Att3_OEUK2_OeukNOK_Wait180s_AskNOK()
{
  testCaseTitle("TC_10", "Check Att_Cnt(ASK)=3, OEUK=2: OEUK NOK => NRC 36 -> 180s -> ASK => NRC 36");
  write("\n=================================================");
  write("[TC_10] START: ASK(3), OEUK(2) -> OEUK NOK => 36 -> 180s -> ASK => 36");
  write("=================================================");

  // Set precondition: Att_Cnt(ASK) = 2, Att_Cnt(OEUK) = 2
  Set_Precondition_Att_Cnt(2, 2);

  // 1. Send OEUK key NOK -> Expect NRC 36 (OEUK reaches 3, triggers 180s delay)
  testStep("STEP_1", "1. Request OEUK key NOK -> Expect NRC 36");
  Send_SecurityAccess_InvalidKey(SUBFUNC_OEUK_SEED, SUBFUNC_OEUK_KEY, NRC_EXCEEDED_NUMBER_OF_ATTEMPTS);

  // 2. Wait 180s lockout timer to expire (OEUK resets to 0, ASK remains 2)
  testStep("STEP_2", "2. Waiting 180 seconds for lockout penalty to expire...");
  Wait_Lockout_Timer_180s();

  // 3. Request ASK key NOK -> Expect NRC 36 (ASK 2+1=3 reaches limit)
  testStep("STEP_3", "3. Request ASK key NOK -> Expect NRC 36");
  Send_SecurityAccess_InvalidKey(SUBFUNC_ASK_SEED, SUBFUNC_ASK_KEY, NRC_EXCEEDED_NUMBER_OF_ATTEMPTS);

  write("[TC_10] FINISHED\n");
}

/*
 * ==============================================================================
 * MainTest: Execute all 10 testcases
 * ==============================================================================
 */
void MainTest()
{
  write("#################################################################");
  write("# RUNNING TEST SUITE: SECURITY ATTEMPT COUNTER & LOCKOUT (1-10) #");
  write("#################################################################");

  // --- Group 1: ASK progression (TC 01 - 03) ---
  TC_01_ASK_Att0_OEUK0_AskNOK();
  testWaitForTimeout(1000);

  TC_02_ASK_Att1_OEUK0_AskNOK();
  testWaitForTimeout(1000);

  TC_03_ASK_Att2_OEUK0_AskNOK();
  testWaitForTimeout(1000);

  // --- Group 2: Mixed ASK & OEUK with 180s delay (TC 04 - 05) ---
  TC_04_ASK_Att2_OEUK1_AskNOK_Wait180s_OeukNOK();
  testWaitForTimeout(1000);

  TC_05_ASK_Att3_OEUK2_AskNOK_Wait180s_OeukNOK();
  testWaitForTimeout(1000);

  // --- Group 3: OEUK progression (TC 06 - 08) ---
  TC_06_ASK_Att0_OEUK0_OeukNOK();
  testWaitForTimeout(1000);

  TC_07_ASK_Att1_OEUK0_OeukNOK();
  testWaitForTimeout(1000);

  TC_08_ASK_Att2_OEUK0_OeukNOK();
  testWaitForTimeout(1000);

  // --- Group 4: Mixed OEUK & ASK with 180s delay (TC 09 - 10) ---
  TC_09_ASK_Att2_OEUK1_OeukNOK_Wait180s_AskNOK();
  testWaitForTimeout(1000);

  TC_10_ASK_Att3_OEUK2_OeukNOK_Wait180s_AskNOK();

  write("#################################################################");
  write("# COMPLETED TEST SUITE: SECURITY ATTEMPT COUNTER & LOCKOUT      #");
  write("#################################################################");
}
