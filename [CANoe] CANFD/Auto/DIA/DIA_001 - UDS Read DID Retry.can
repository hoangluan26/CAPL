void MainTest()
{
  testReportFileName("TestReports\\DIA_001 - UDS Read DID Retry_report");

  DIA_001_Init();
  DIA_001_1();
  DIA_001_2();
  DIA_001_3();
  DIA_001_4();
  DIA_001_5();
}
