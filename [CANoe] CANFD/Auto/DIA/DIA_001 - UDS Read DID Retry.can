  step2_passed = (result == 1);
  if (step2_passed == 1)
  {
    testStepPass("Step2", "Received positive response for DID F1C1");
  }
  else
  {
    testStepFail("Step2", "No positive response for DID F1C1 within the retry limit");
  }

  write("=== FINISH STEP 2 ===");
  StopTestTimer();
